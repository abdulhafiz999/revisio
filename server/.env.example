# ============================================================================
# REVISIO Backend Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env files to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------------------------

# Node environment: development, staging, or production
NODE_ENV=development

# Port for the Express server to listen on
PORT=3000

# Frontend URL(s) for CORS configuration (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:5173

# ----------------------------------------------------------------------------
# Supabase Configuration
# ----------------------------------------------------------------------------

# Supabase project URL
# Find this in your Supabase project settings under API
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous key (public key)
# Used for client-side operations and user authentication
# Find this in your Supabase project settings under API > Project API keys > anon public
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase service role key (secret key)
# Used for server-side admin operations - KEEP THIS SECRET!
# Find this in your Supabase project settings under API > Project API keys > service_role secret
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# ----------------------------------------------------------------------------
# AI Service Configuration
# ----------------------------------------------------------------------------

# Google Gemini API Key (primary AI service)
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model for generateContent (see https://generativelanguage.googleapis.com/v1beta/models)
# gemini-2.5-flash is more reliable under load; lite can return 503 "high demand"
GEMINI_MODEL=gemini-2.5-flash

# Max note characters sent to Gemini (lower = faster, less context)
GEMINI_CONTENT_MAX_CHARS=10000

# OpenAI API Key (fallback AI service)
# Get your API key from: https://platform.openai.com/api-keys
# Optional: Only needed if you want OpenAI as a fallback
OPENAI_API_KEY=your-openai-api-key-here

# ----------------------------------------------------------------------------
# Cloudinary Configuration
# ----------------------------------------------------------------------------

# Cloudinary Cloud Name
# Find this in your Cloudinary dashboard under Account Details
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

# Cloudinary API Key
# Find this in your Cloudinary dashboard under Account Details > API Keys
CLOUDINARY_API_KEY=your-cloudinary-api-key

# Cloudinary API Secret
# Find this in your Cloudinary dashboard under Account Details > API Keys
# KEEP THIS SECRET!
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ----------------------------------------------------------------------------
# Optional Configuration
# ----------------------------------------------------------------------------

# JWT secret for additional token signing (if needed)
# Generate a random string: openssl rand -base64 32
# JWT_SECRET=your-jwt-secret-here

# Database connection pool size (optional)
# DB_POOL_SIZE=10

# API request timeout in milliseconds (optional)
# API_TIMEOUT=30000

# Maximum file upload size in MB (optional)
# MAX_UPLOAD_SIZE=10

# Rate limit: requests per minute (optional)
# RATE_LIMIT_MAX=100

# Rate limit window in minutes (optional)
# RATE_LIMIT_WINDOW=1

# Log level: error, warn, info, debug (optional)
# LOG_LEVEL=info
